<!-- TOP COLLAPSIBLE: SEND EVENT TO HOOKYARD -->
<details class="send-event-collapsible" <%= 'open' if @result.present? %>>
  <summary>
    <div style="display: flex; align-items: center; gap: 8px;">
      <span style="font-size: 1rem;">📤</span>
      <span><strong>Send Event to HookYard</strong></span>
      <span style="font-size: 0.8rem; font-weight: normal; color: var(--text-muted);">(Manual Test Event Dispatcher)</span>
    </div>
    <% if @result.present? %>
      <span class="badge <%= @result.success? ? 'badge-200' : 'badge-500' %>">
        Last Event: HTTP <%= @result.status_code %>
      </span>
    <% else %>
      <span style="font-size: 0.8rem; color: var(--primary);">Click to expand / collapse ▾</span>
    <% end %>
  </summary>

  <div class="send-event-body">
    <%= form_with url: send_event_path, method: :post, local: true do |f| %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-bottom: 12px;">
        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :hookyard_url, "HookYard API URL" %>
          <%= f.text_field :hookyard_url, value: @hookyard_url, placeholder: "http://localhost:3000/api/v1/events", class: "form-control" %>
          <div class="hint">Endpoint where events should be dispatched</div>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <%= f.label :api_token, "Project API Token", style: "margin-bottom: 0;" %>
            <div style="display: flex; align-items: center; gap: 6px;">
              <span id="api-key-status" class="badge badge-rejected">Not configured</span>
              <button type="button" id="clear-api-key-btn" class="btn btn-sm btn-outline" style="display: none; padding: 2px 6px; font-size: 0.7rem; color: var(--danger-text);">Clear key</button>
            </div>
          </div>
          <%= f.password_field :api_token, value: "", placeholder: "Enter project API token (saved in sessionStorage)", class: "form-control", id: "project-api-token-input", autocomplete: "off" %>
          <div class="hint">Sent as <code>Authorization: Bearer &lt;token&gt;</code>. Kept in tab sessionStorage.</div>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :event_type, "Event Type" %>
          <%= f.text_field :event_type, value: @event_type, placeholder: "order.created", class: "form-control" %>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :idempotency_key, "Idempotency Key" %>
          <%= f.text_field :idempotency_key, value: @idempotency_key, class: "form-control" %>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 12px;">
        <%= f.label :payload, "Payload (JSON)" %>
        <%= f.text_area :payload, value: @payload, rows: 4, class: "form-control code" %>
        <div class="hint">Must be valid JSON</div>
      </div>

      <div>
        <%= f.submit "Send Event", class: "btn btn-primary" %>
      </div>
    <% end %>

    <% if @result.present? %>
      <div class="response-box <%= @result.success? ? 'success' : 'error' %>" style="margin-top: 14px;">
        <div class="response-header">
          <span><%= @result.success? ? "Event Sent Successfully" : "Event Delivery Failed" %></span>
          <% if @result.status_code %>
            <span class="badge <%= @result.success? ? 'badge-200' : 'badge-500' %>">
              HTTP <%= @result.status_code %>
            </span>
          <% end %>
        </div>

        <% if @result.error.present? %>
          <div style="margin-bottom: 8px; font-weight: 600;"><%= @result.error %></div>
        <% end %>

        <% if @result.body.present? %>
          <div style="margin-top: 8px;">
            <div style="font-size: 0.8rem; font-weight: 600; margin-bottom: 4px;">Response Body:</div>
            <pre><%= @result.body %></pre>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</details>

<!-- MAIN BALANCED GRID: LEFT = RECEIVER CONFIG, RIGHT = RECEIVED REQUESTS -->
<div class="main-grid">
  <!-- LEFT: RECEIVER ROUTES & CONFIGURATION -->
  <section class="card">
    <h2 class="card-title" style="display: flex; justify-content: space-between; align-items: center;">
      <span>Receiver Scenarios</span>
    </h2>
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: -8px; margin-bottom: 14px;">
      Each receiver route can return a different response, so one HookYard event can be tested across multiple endpoints.
    </p>

    <!-- ROUTE SELECTOR TABS -->
    <div class="route-nav-tabs" role="tablist">
      <% @receiver_routes.each do |key| %>
        <% setting = @route_settings[key] %>
        <button type="button" class="route-nav-tab <%= 'active' if key == @active_route %>" data-route-tab="<%= key %>">
          <span><%= setting.route_label.split(" ").first %></span>
          <span class="badge <%= setting.active_badge_class %>" style="font-size: 0.65rem; padding: 1px 5px;">
            <%= setting.status_code %>
          </span>
          <% if setting.delay_seconds.to_i > 0 %>
            <span class="badge badge-unconfigured" style="font-size: 0.65rem; padding: 1px 4px;">
              +<%= setting.delay_seconds %>s
            </span>
          <% end %>
        </button>
      <% end %>
    </div>

    <!-- ROUTE CONFIGURATION PANELS -->
    <% @receiver_routes.each do |key| %>
      <% setting = @route_settings[key] %>
      <div class="route-panel <%= 'active' if key == @active_route %>" id="panel-<%= key %>">
        <!-- Route URL & Active Banner Box -->
        <div class="route-endpoint-box">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; flex-wrap: wrap; gap: 6px;">
            <div>
              <span style="font-size: 0.85rem; color: var(--text-muted);">Receiver Route:</span>
              <strong style="font-size: 0.95rem; margin-left: 4px;"><code><%= setting.route_path %></code></strong>
            </div>
            <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
              <span class="badge <%= setting.active_badge_class %>"><%= setting.active_status_text %></span>
              <% if setting.delay_label && setting.fixed_mode? %>
                <span class="badge badge-unconfigured"><%= setting.delay_label %></span>
              <% end %>
            </div>
          </div>
          <div class="hint" style="font-size: 0.78rem;">
            HookYard destination URL: <code>http://&lt;hookre-host&gt;<%= setting.route_path %></code>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid var(--border-color); border-radius: 6px; padding: 12px; margin-bottom: 16px;">
          <div class="receiver-status-row" style="margin-bottom: 6px;">
            <span><strong>Endpoint Signing Secret:</strong></span>
            <% if SigningSecretStore.configured_for?(key) %>
              <span class="badge badge-verified badge-sig-verified" data-receiver-secret-badge="<%= key %>">Configured</span>
            <% else %>
              <span class="badge badge-rejected badge-unconfigured" data-receiver-secret-badge="<%= key %>">Not configured</span>
            <% end %>
          </div>
          <div class="hint" style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 8px;">
            Use the signing secret of the HookYard Endpoint targeting <code><%= setting.route_path %></code>.
            Secrets are stored in this Rails process only (single worker); they are not shared across processes or persisted.
          </div>
          <%= form_with url: receiver_secret_path(key), method: :post, local: true,
              html: { style: "display: flex; gap: 8px; align-items: center; flex-wrap: wrap;", data: { receiver_secret_form: key, receiver_route_key: key, receiver_secret_storage_key: "hookre_endpoint_signing_secret_#{key}", server_configured: SigningSecretStore.configured_for?(key) } } do %>
            <%= password_field_tag :signing_secret, "", placeholder: "Enter whsec_...", class: "form-control receiver-secret-input", autocomplete: "new-password", style: "flex: 1; min-width: 140px;" %>
            <%= submit_tag "Save Secret", class: "btn btn-sm btn-primary" %>
          <% end %>
          <div style="margin-top: 6px; text-align: right;">
            <button type="button"
                class="btn btn-sm btn-outline clear-receiver-secret-btn"
                data-receiver-route-key="<%= key %>"
                data-receiver-secret-storage-key="hookre_endpoint_signing_secret_<%= key %>"
                data-clear-receiver-secret-url="<%= clear_receiver_secret_path(key) %>"
                style="color: var(--danger-text);">Clear Secret</button>
          </div>
        </div>

        <!-- RESPONSE MODE SWITCHER TABS: Fixed vs Sequence -->
        <div class="scenario-mode-tabs" role="tablist">
          <button type="button" class="scenario-mode-tab <%= 'active' if setting.fixed_mode? %>" data-mode-tab="<%= key %>" data-target-mode="fixed">
            Fixed Response
          </button>
          <button type="button" class="scenario-mode-tab <%= 'active' if setting.sequence_mode? %>" data-mode-tab="<%= key %>" data-target-mode="sequence">
            Response Sequence
          </button>
        </div>

        <!-- 1. FIXED RESPONSE CONTROLS (Displayed when Fixed is active) -->
        <div class="scenario-panel <%= 'active' if setting.fixed_mode? %>" id="fixed-controls-<%= key %>">
          <!-- Presets -->
          <div style="margin-bottom: 14px;">
            <div style="font-size: 0.85rem; font-weight: 600; margin-bottom: 6px;">Status Presets:</div>
            <div class="preset-buttons">
              <% [
                   [200, "200 OK"],
                   [400, "400 Bad Request"],
                   [408, "408 Request Timeout"],
                   [429, "429 Too Many Requests"],
                   [500, "500 Internal Server Error"],
                   [503, "503 Service Unavailable"]
                 ].each do |code, label| %>
                <%= button_to label, update_receiver_setting_path(route_key: key, status_code: code, response_mode: "fixed"),
                    method: :post,
                    class: "btn btn-sm #{setting.status_code == code && setting.fixed_mode? ? 'btn-primary' : 'btn-outline'}",
                    style: "font-size: 0.8rem; padding: 4px 10px;" %>
              <% end %>
            </div>
          </div>

          <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: 6px; padding: 14px;">
            <h4 style="font-size: 0.9rem; font-weight: 600; margin-bottom: 12px; color: var(--text-color);">
              Fixed Response for <%= setting.route_label %>
            </h4>

            <%= form_with url: update_receiver_setting_path, method: :post, local: true do %>
              <%= hidden_field_tag :route_key, key %>
              <%= hidden_field_tag :response_mode, "fixed" %>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div class="form-group" style="margin-bottom: 0;">
                  <label for="status_code_<%= key %>">Custom HTTP Status (100–599)</label>
                  <%= number_field_tag :status_code, setting.status_code, min: 100, max: 599, required: true, id: "status_code_#{key}", class: "form-control" %>
                  <div class="hint">Returns exact HTTP code</div>
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                  <label for="delay_seconds_<%= key %>">Response Delay (0–60s)</label>
                  <%= number_field_tag :delay_seconds, setting.delay_seconds, min: 0, max: 60, id: "delay_seconds_#{key}", class: "form-control" %>
                  <div class="hint">Delay &gt; 15s triggers HookYard timeout</div>
                </div>
              </div>

              <div class="form-group" style="margin-bottom: 12px;">
                <label for="response_body_<%= key %>">Response Body (Optional, max 2 KB)</label>
                <%= text_area_tag :response_body, setting.response_body, rows: 2, maxlength: 2048, id: "response_body_#{key}", placeholder: 'Default: {"received": true}', class: "form-control code" %>
                <div class="hint">Custom JSON or plain text body to return</div>
              </div>

              <div style="text-align: right;">
                <%= submit_tag "Save Fixed Settings", class: "btn btn-sm btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- 2. RESPONSE SEQUENCE CONTROLS (Displayed when Sequence is active) -->
        <div class="scenario-panel <%= 'active' if setting.sequence_mode? %>" id="sequence-controls-<%= key %>">
          <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: 6px; padding: 14px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 6px;">
              <div>
                <h4 style="font-size: 0.9rem; font-weight: 600; margin: 0; color: var(--text-color);">
                  Response Sequence (1–20 Ordered Steps)
                </h4>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                  Progress: <strong>Step <%= setting.parsed_steps.any? ? [setting.sequence_index + 1, setting.parsed_steps.size].min : 0 %> of <%= setting.parsed_steps.size %></strong>
                  <% if setting.parsed_steps.any? && setting.sequence_index >= setting.parsed_steps.size - 1 %>
                    <span class="badge badge-unconfigured" style="margin-left: 4px; font-size: 0.65rem;">Repeating final step</span>
                  <% end %>
                </div>
              </div>
              <div>
                <%= button_to "Reset scenario progress", reset_sequence_progress_path(route_key: key), method: :post,
                    class: "btn btn-sm btn-outline",
                    style: "font-size: 0.75rem; padding: 2px 8px; color: var(--primary);" %>
              </div>
            </div>

            <p style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 12px;">
              Each incoming webhook uses the next step in order. After the last step, the final step repeats until reset.
            </p>

            <%= form_with url: update_receiver_setting_path, method: :post, local: true, id: "sequence-form-#{key}" do %>
              <%= hidden_field_tag :route_key, key %>
              <%= hidden_field_tag :response_mode, "sequence" %>

              <!-- Steps Container -->
              <div class="steps-container" id="steps-container-<%= key %>" data-route="<%= key %>">
                <% steps = setting.parsed_steps.presence || [{ "status_code" => 500, "delay_seconds" => 0 }, { "status_code" => 200, "delay_seconds" => 0 }] %>
                <% steps.each_with_index do |st, s_idx| %>
                  <div class="sequence-step-row" data-step-index="<%= s_idx %>">
                    <span class="sequence-step-num">#<%= s_idx + 1 %></span>
                    <div style="display: flex; gap: 6px; align-items: center; flex: 1;">
                      <label style="font-size: 0.75rem; margin: 0; color: var(--text-muted);">Status:</label>
                      <input type="number" name="steps[][status_code]" value="<%= st['status_code'] %>" min="100" max="599" required class="form-control" style="width: 75px; font-size: 0.8rem; padding: 3px 6px;">

                      <label style="font-size: 0.75rem; margin: 0; color: var(--text-muted); margin-left: 6px;">Delay:</label>
                      <input type="number" name="steps[][delay_seconds]" value="<%= st['delay_seconds'] || 0 %>" min="0" max="60" class="form-control" style="width: 60px; font-size: 0.8rem; padding: 3px 6px;">
                      <span style="font-size: 0.75rem; color: var(--text-muted);">s</span>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                      <input type="text" name="steps[][response_body]" value="<%= st['response_body'] %>" placeholder="Body (optional)" maxlength="2048" class="form-control" style="font-size: 0.8rem; padding: 3px 6px; max-width: 140px;">
                      <button type="button" class="btn btn-sm btn-outline remove-step-btn" style="color: var(--danger-text); padding: 2px 6px; font-size: 0.75rem;" title="Remove step">✕</button>
                    </div>
                  </div>
                <% end %>
              </div>

              <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
                <button type="button" class="btn btn-sm btn-outline add-step-btn" data-target="steps-container-<%= key %>" style="font-size: 0.8rem;">
                  + Add response step
                </button>
                <%= submit_tag "Save Response Sequence", class: "btn btn-sm btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </section>

  <!-- RIGHT: RECEIVED REQUESTS -->
  <section class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; flex-wrap: wrap; gap: 8px;">
      <h2 style="font-size: 1.25rem; font-weight: 600; margin: 0;">Recent Requests</h2>
      <div style="display: flex; gap: 8px; align-items: center;">
        <span style="font-size: 0.85rem; color: var(--text-muted);"><span id="total-received-count"><%= @webhook_count %></span> requests</span>
        <%= button_to "Clear History", clear_webhooks_history_path, method: :delete,
            class: "btn btn-sm btn-outline",
            style: "color: var(--danger-text); padding: 3px 8px; font-size: 0.75rem;",
            onclick: "return confirm('Are you sure you want to clear the received request history?');" %>
      </div>
    </div>

    <!-- FILTER TABS: All, Success, Failure, Slow, Custom -->
    <div class="filter-tabs">
      <button type="button" class="filter-tab <%= 'active' if @active_route == 'all' %>" data-route-filter="all">
        All
      </button>
      <button type="button" class="filter-tab <%= 'active' if @active_route == 'success' %>" data-route-filter="success">
        Success receiver
      </button>
      <button type="button" class="filter-tab <%= 'active' if @active_route == 'failure' %>" data-route-filter="failure">
        Failure receiver
      </button>
      <button type="button" class="filter-tab <%= 'active' if @active_route == 'slow' %>" data-route-filter="slow">
        Slow receiver
      </button>
      <button type="button" class="filter-tab <%= 'active' if @active_route == 'custom' %>" data-route-filter="custom">
        Custom receiver
      </button>
    </div>

    <div id="recent-webhooks-container">
      <%= render partial: "webhooks/recent_list", locals: { webhooks: @webhooks, webhook_count: @webhook_count, active_route: @active_route } %>
    </div>
  </section>
</div>

<%= javascript_include_tag "receiver_secret_badges" %>
<script>
  (function() {
    // 1. Project API Token - Tab Session Persistence
    const TOKEN_STORAGE_KEY = "hookre_project_api_token";
    const tokenInput = document.getElementById("project-api-token-input");
    const tokenStatus = document.getElementById("api-key-status");
    const clearTokenBtn = document.getElementById("clear-api-key-btn");

    function updateTokenUi(hasToken) {
      if (hasToken) {
        if (tokenStatus) {
          tokenStatus.textContent = "Configured";
          tokenStatus.className = "badge badge-verified";
        }
        if (clearTokenBtn) clearTokenBtn.style.display = "inline-block";
      } else {
        if (tokenStatus) {
          tokenStatus.textContent = "Not configured";
          tokenStatus.className = "badge badge-rejected";
        }
        if (clearTokenBtn) clearTokenBtn.style.display = "none";
      }
    }

    if (tokenInput) {
      try {
        const storedToken = sessionStorage.getItem(TOKEN_STORAGE_KEY);
        if (storedToken && storedToken.trim().length > 0) {
          tokenInput.value = storedToken;
          updateTokenUi(true);
        } else {
          updateTokenUi(false);
        }
      } catch (e) {}

      tokenInput.addEventListener("input", function() {
        const val = tokenInput.value.trim();
        try {
          if (val.length > 0) {
            sessionStorage.setItem(TOKEN_STORAGE_KEY, tokenInput.value);
            updateTokenUi(true);
          } else {
            sessionStorage.removeItem(TOKEN_STORAGE_KEY);
            updateTokenUi(false);
          }
        } catch (e) {}
      });

      if (clearTokenBtn) {
        clearTokenBtn.addEventListener("click", function() {
          try { sessionStorage.removeItem(TOKEN_STORAGE_KEY); } catch (e) {}
          tokenInput.value = "";
          updateTokenUi(false);
        });
      }

      const tokenForm = tokenInput.closest("form");
      if (tokenForm) {
        tokenForm.addEventListener("submit", function() {
          if (tokenInput.value) {
            try { sessionStorage.setItem(TOKEN_STORAGE_KEY, tokenInput.value); } catch (e) {}
          }
        });
      }
    }

    // 2. Route-scoped signing secrets. The legacy global key is intentionally ignored.
    const secretBadges = window.HookReReceiverSecretBadges;
    if (secretBadges) secretBadges.initializeReceiverSecretUi();

    // 3. Receiver Route Selector Tabs (Left Panel)
    const routeTabs = document.querySelectorAll("[data-route-tab]");
    routeTabs.forEach(function(tab) {
      tab.addEventListener("click", function() {
        const routeKey = tab.getAttribute("data-route-tab");
        routeTabs.forEach(t => t.classList.remove("active"));
        tab.classList.add("active");

        document.querySelectorAll(".route-panel").forEach(p => p.classList.remove("active"));
        const targetPanel = document.getElementById("panel-" + routeKey);
        if (targetPanel) targetPanel.classList.add("active");
      });
    });

    // 4. Scenario Mode Tabs (Fixed vs Sequence)
    const scenarioTabs = document.querySelectorAll(".scenario-mode-tab");
    scenarioTabs.forEach(function(btn) {
      btn.addEventListener("click", function() {
        const routeKey = btn.getAttribute("data-mode-tab");
        const mode = btn.getAttribute("data-target-mode");

        document.querySelectorAll('.scenario-mode-tab[data-mode-tab="' + routeKey + '"]').forEach(b => b.classList.remove("active"));
        btn.classList.add("active");

        const fixedPanel = document.getElementById("fixed-controls-" + routeKey);
        const seqPanel = document.getElementById("sequence-controls-" + routeKey);
        if (mode === "fixed") {
          if (fixedPanel) fixedPanel.classList.add("active");
          if (seqPanel) seqPanel.classList.remove("active");
        } else {
          if (fixedPanel) fixedPanel.classList.remove("active");
          if (seqPanel) seqPanel.classList.add("active");
        }
      });
    });

    // 5. Sequence Steps Add/Remove Editor
    document.addEventListener("click", function(e) {
      if (e.target && e.target.classList.contains("add-step-btn")) {
        const targetId = e.target.getAttribute("data-target");
        const container = document.getElementById(targetId);
        if (!container) return;

        const rows = container.querySelectorAll(".sequence-step-row");
        if (rows.length >= 20) {
          alert("Maximum 20 steps per sequence.");
          return;
        }

        const nextNum = rows.length + 1;
        const newRow = document.createElement("div");
        newRow.className = "sequence-step-row";
        newRow.innerHTML = `
          <span class="sequence-step-num">#${nextNum}</span>
          <div style="display: flex; gap: 6px; align-items: center; flex: 1;">
            <label style="font-size: 0.75rem; margin: 0; color: var(--text-muted);">Status:</label>
            <input type="number" name="steps[][status_code]" value="200" min="100" max="599" required class="form-control" style="width: 75px; font-size: 0.8rem; padding: 3px 6px;">

            <label style="font-size: 0.75rem; margin: 0; color: var(--text-muted); margin-left: 6px;">Delay:</label>
            <input type="number" name="steps[][delay_seconds]" value="0" min="0" max="60" class="form-control" style="width: 60px; font-size: 0.8rem; padding: 3px 6px;">
            <span style="font-size: 0.75rem; color: var(--text-muted);">s</span>
          </div>
          <div style="display: flex; gap: 6px; align-items: center;">
            <input type="text" name="steps[][response_body]" value="" placeholder="Body (optional)" maxlength="2048" class="form-control" style="font-size: 0.8rem; padding: 3px 6px; max-width: 140px;">
            <button type="button" class="btn btn-sm btn-outline remove-step-btn" style="color: var(--danger-text); padding: 2px 6px; font-size: 0.75rem;" title="Remove step">✕</button>
          </div>
        `;
        container.appendChild(newRow);
      }

      if (e.target && e.target.classList.contains("remove-step-btn")) {
        const row = e.target.closest(".sequence-step-row");
        const container = row?.parentElement;
        if (row && container) {
          const allRows = container.querySelectorAll(".sequence-step-row");
          if (allRows.length <= 1) {
            alert("Sequence must contain at least 1 step.");
            return;
          }
          row.remove();
          container.querySelectorAll(".sequence-step-row").forEach((r, idx) => {
            const numEl = r.querySelector(".sequence-step-num");
            if (numEl) numEl.textContent = "#" + (idx + 1);
          });
        }
      }
    });

    // 6. Recent Requests Filter Tabs & Polling (Right Panel)
    let currentRouteFilter = "<%= @active_route %>";
    let lastHtml = null;

    const filterTabs = document.querySelectorAll("[data-route-filter]");
    filterTabs.forEach(function(btn) {
      btn.addEventListener("click", function() {
        const route = btn.getAttribute("data-route-filter");
        if (route === currentRouteFilter) return;

        currentRouteFilter = route;
        filterTabs.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");

        fetchRecentWebhooks();
      });
    });

    function fetchRecentWebhooks() {
      const container = document.getElementById("recent-webhooks-container");
      if (!container) return;

      const url = "<%= recent_webhooks_path %>?route=" + encodeURIComponent(currentRouteFilter);

      fetch(url, {
        headers: {
          "Accept": "text/html",
          "X-Requested-With": "XMLHttpRequest"
        }
      })
      .then(function(res) {
        if (res.ok) return res.text();
      })
      .then(function(html) {
        if (!html || html === lastHtml) return;
        lastHtml = html;
        container.innerHTML = html;

        const countEl = container.querySelector("[data-webhook-count]");
        const totalEl = document.getElementById("total-received-count");
        if (countEl && totalEl) {
          totalEl.textContent = countEl.getAttribute("data-webhook-count");
        }
      })
      .catch(function() {});
    }

    setInterval(fetchRecentWebhooks, 2000);
  })();
</script>
